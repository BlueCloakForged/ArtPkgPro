{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "artifacts_package_answers_v0.3.schema.json",
  "title": "ArtPkg v0.3 requirements gateway",
  "type": "object",
  "required": ["schema_version", "artifact_type", "package"],
  "properties": {
    "schema_version": {"const": "0.3"},
    "artifact_type": {"enum": ["GENERAL", "REQUIREMENT_INTAKE", "EVIDENCE_ENRICHED_SCOPE"]},
    "package": {"$ref": "#/$defs/package"},
    "requirement_intake": {"$ref": "#/$defs/intake"},
    "scope": {"$ref": "#/$defs/scope"},
    "evidence": {"type": "array", "items": {"type": "object", "required": ["relation_type"], "properties": {"relation_type": {"enum": ["SUPPORTS_SCOPE_INTERPRETATION", "CONTRADICTS_CURRENT_BEHAVIOR", "REQUIRES_REQUIREMENT_REFINEMENT"]}}}}
  },
  "allOf": [
    {"if": {"properties": {"artifact_type": {"const": "REQUIREMENT_INTAKE"}}}, "then": {"required": ["requirement_intake"]}},
    {"if": {"properties": {"artifact_type": {"const": "EVIDENCE_ENRICHED_SCOPE"}}}, "then": {"required": ["scope", "evidence"]}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "package": {"type": "object", "required": ["package_id", "package_revision"], "properties": {"package_id": {"type": "string", "minLength": 1}, "package_revision": {"type": "integer", "minimum": 1}, "package_digest": {"$ref": "#/$defs/digest"}}},
    "person": {"type": "object", "required": ["name_or_role"], "properties": {"name_or_role": {"type": "string", "minLength": 1}}},
    "approval": {"type": "object", "required": ["status", "approved_at", "approval_reference"], "properties": {"status": {"enum": ["DRAFT", "APPROVED_FOR_DISCOVERY", "SCOPE_APPROVED"]}, "approved_at": {"type": ["string", "null"]}, "approval_reference": {"type": ["string", "null"]}}},
    "eligibility": {"type": "object", "required": ["eligible", "boundary", "exclusions", "expiry_or_checkpoint", "stop_conditions"], "properties": {"eligible": {"type": "boolean"}, "boundary": {"type": ["string", "null"]}, "exclusions": {"type": "array", "items": {"type": "string"}}, "expiry_or_checkpoint": {"type": ["string", "null"]}, "stop_conditions": {"type": "array", "items": {"type": "string"}}}},
    "requirement": {"type": "object", "required": ["requirement_id", "source_type", "requirement_confidence", "intended_behavior", "trigger_or_applicability", "expected_valid_outcome", "expected_invalid_fail_closed_outcome", "business_or_domain_reason", "compatibility_constraints", "regulatory_policy_constraints", "exclusions_non_goals"], "properties": {"requirement_id": {"type": "string", "minLength": 1}, "source_type": {"const": "HUMAN_DECLARATION"}, "requirement_confidence": {"type": "object", "required": ["value", "basis_type", "human_attestation", "evidence_used_as_authority", "basis_text"], "properties": {"value": {"enum": ["HIGH", "MEDIUM", "LOW"]}, "basis_type": {"enum": ["HUMAN_OWNER_JUDGMENT", "HUMAN_DOMAIN_JUDGMENT", "HUMAN_APPROVER_JUDGMENT", "OTHER_HUMAN_DECLARED_BASIS"]}, "human_attestation": {"const": true}, "evidence_used_as_authority": {"const": false}, "basis_text": {"type": "string", "minLength": 1}}}, "intended_behavior": {"type": "string", "minLength": 1}, "trigger_or_applicability": {"type": "string", "minLength": 1}, "expected_valid_outcome": {"type": "string", "minLength": 1}, "expected_invalid_fail_closed_outcome": {"type": "string", "minLength": 1}, "business_or_domain_reason": {"type": "string", "minLength": 1}, "compatibility_constraints": {"type": "array", "minItems": 1}, "regulatory_policy_constraints": {"type": "array", "minItems": 1}, "exclusions_non_goals": {"type": "array", "minItems": 1}}},
    "intake": {"type": "object", "required": ["intake_id", "requirement_revision", "requirement_digest", "status", "requirement_authority_basis", "human_owner", "human_approver", "approval", "requirements", "unresolved_questions", "revision_lineage", "discovery_eligibility"], "properties": {"intake_id": {"type": "string", "minLength": 1}, "requirement_revision": {"type": "integer", "minimum": 1}, "requirement_digest": {"$ref": "#/$defs/digest"}, "status": {"enum": ["DRAFT", "NEEDS_REFINEMENT", "APPROVED_FOR_DISCOVERY", "SUPERSEDED", "REJECTED"]}, "requirement_authority_basis": {"enum": ["PRODUCT_OWNER_DECLARATION", "DOMAIN_OWNER_DECLARATION", "REGULATORY_SOURCE", "CONTRACTUAL_SOURCE", "POLICY_SOURCE", "OTHER_HUMAN_APPROVED_SOURCE"]}, "human_owner": {"$ref": "#/$defs/person"}, "human_approver": {"$ref": "#/$defs/person"}, "approval": {"$ref": "#/$defs/approval"}, "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}}, "unresolved_questions": {"type": "array"}, "revision_lineage": {"type": "object"}, "discovery_eligibility": {"$ref": "#/$defs/eligibility"}}},
    "snapshot": {"type": "object", "required": ["intake_id", "requirement_revision", "requirement_digest", "approved_requirement_authority"], "properties": {"intake_id": {"type": "string", "minLength": 1}, "requirement_revision": {"type": "integer", "minimum": 1}, "requirement_digest": {"$ref": "#/$defs/digest"}, "approved_requirement_authority": {"type": "object"}}},
    "candidate": {"type": "object", "required": ["candidate_id", "proposed_change", "observed_current_behavior", "execution_path", "direct_callers", "direct_tests", "contract_interface_evidence", "expected_affected_surfaces", "preserved_surfaces", "blast_radius", "unresolved_assumption_ids", "unresolved_conflict_ids", "positive_acceptance_criterion", "negative_fail_closed_criterion", "regression_criterion", "rollback_criterion", "implementation_exclusions"], "properties": {"candidate_id": {"type": "string", "minLength": 1}, "proposed_change": {"type": "string", "minLength": 1}, "observed_current_behavior": {"type": "string", "minLength": 1}, "execution_path": {"type": "array", "minItems": 1}, "direct_callers": {"type": "array", "minItems": 1}, "direct_tests": {"type": "array", "minItems": 1}, "contract_interface_evidence": {"type": "array", "minItems": 1}, "expected_affected_surfaces": {"type": "array", "minItems": 1}, "preserved_surfaces": {"type": "array", "minItems": 1}, "blast_radius": {"type": "string", "minLength": 1}, "unresolved_assumption_ids": {"type": "array"}, "unresolved_conflict_ids": {"type": "array"}, "positive_acceptance_criterion": {"type": "string", "minLength": 1}, "negative_fail_closed_criterion": {"type": "string", "minLength": 1}, "regression_criterion": {"type": "string", "minLength": 1}, "rollback_criterion": {"type": "string", "minLength": 1}, "implementation_exclusions": {"type": "array", "minItems": 1}}},
    "scope": {"type": "object", "required": ["scope_id", "status", "requirement_snapshot", "dwo_binding", "discovery_run_binding", "candidates", "scope_approval"], "properties": {"scope_id": {"type": "string", "minLength": 1}, "status": {"enum": ["DRAFT", "EVIDENCE_BOUND", "SCOPE_APPROVED", "SUPERSEDED", "REJECTED", "BLOCKED"]}, "requirement_snapshot": {"$ref": "#/$defs/snapshot"}, "dwo_binding": {"type": "object", "required": ["dwo_id", "requirement_binding", "approval_attestation", "discovery_authority", "dwo_digest"], "properties": {"dwo_id": {"type": "string", "minLength": 1}, "requirement_binding": {"type": "object", "required": ["intake_id", "requirement_revision", "requirement_digest", "selected_requirement_ids"], "properties": {"intake_id": {"type": "string", "minLength": 1}, "requirement_revision": {"type": "integer", "minimum": 1}, "requirement_digest": {"$ref": "#/$defs/digest"}, "selected_requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}, "approval_attestation": {"$ref": "#/$defs/approval"}, "discovery_authority": {"$ref": "#/$defs/eligibility"}, "dwo_digest": {"$ref": "#/$defs/digest"}}}, "discovery_run_binding": {"type": "object", "required": ["run_id", "snapshot", "completed_at", "evidence_manifest_digest"], "properties": {"run_id": {"type": "string", "minLength": 1}, "snapshot": {"type": "string", "minLength": 1}, "completed_at": {"type": "string", "minLength": 1}, "evidence_manifest_digest": {"$ref": "#/$defs/digest"}}}, "candidates": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/candidate"}}, "scope_approval": {"type": "object", "required": ["status", "approver", "approved_at", "approval_reference"], "properties": {"status": {"enum": ["DRAFT", "SCOPE_APPROVED"]}, "approver": {"type": ["string", "null"]}, "approved_at": {"type": ["string", "null"]}, "approval_reference": {"type": ["string", "null"]}}}}}
  }
}
